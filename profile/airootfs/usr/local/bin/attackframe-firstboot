#!/usr/bin/env bash
# One-shot system setup. Runs on every live boot (fresh overlay) and once on an
# installed system. Done at boot rather than at ISO build time so nothing here
# collides with files owned by packages.
set -uo pipefail
AFS=/usr/share/attackframe
LIVE=0; { [[ -d /run/live/medium ]] || grep -qw 'boot=live' /proc/cmdline; } && LIVE=1
log() { echo "[attackframe-firstboot] $*"; }

# ---- container storage ---------------------------------------------------
# On the live ISO / is an overlay over squashfs, and Docker's overlay storage
# can't sit on top of another overlay. Give Docker (and containerd, its image
# store) a tmpfs; this runs before docker.service starts. The baked Kali and
# BlackArch image is loaded from /usr/share/attackframe/images on first use.
# RAM is tight for big images (loading one briefly needs ~2x its size), so a
# partition labelled AF-DOCKER (ext4/xfs/btrfs, e.g. on the boot USB or an
# internal disk) is used for Docker's storage instead when it's present.
if (( LIVE )); then
  part=$(blkid -L AF-DOCKER 2>/dev/null || true)
  if [[ -n $part ]] && ! mountpoint -q /var/lib/docker; then
    mkdir -p /mnt/af-docker /var/lib/docker /var/lib/containerd
    if mount "$part" /mnt/af-docker; then
      mkdir -p /mnt/af-docker/docker /mnt/af-docker/containerd
      mount --bind /mnt/af-docker/docker /var/lib/docker
      mount --bind /mnt/af-docker/containerd /var/lib/containerd
      log "Docker storage on $part (AF-DOCKER) — boxes and images persist across boots"
    fi
  fi
  for d in /var/lib/docker /var/lib/containerd; do
    mountpoint -q "$d" && continue
    mkdir -p "$d"
    mount -t tmpfs -o size=75%,mode=0711 tmpfs "$d" && log "$d on tmpfs (RAM)"
  done
fi

# ---- GNOME Shell theme ---------------------------------------------------
/usr/local/bin/attackframe-theme || true

# ---- tool launchers + icon cache + dconf ---------------------------------
/usr/local/bin/attackframe-launchers || true
for d in /usr/share/icons/hicolor /usr/share/icons/AttackFrame-*; do gtk-update-icon-cache -qf "$d" 2>/dev/null || true; done
dconf update 2>/dev/null || true

# ---- live operator ---------------------------------------------------------
# live-config normally creates "ghost" before we run (username=ghost on the kernel
# command line, needs the user-setup package). If it didn't, create the account
# here so login, autologin and the password never depend on live-config.
if (( LIVE )); then
  if ! id ghost &>/dev/null; then
    log "live-config did not create ghost — creating it"
    useradd -m -u 1000 -s /usr/bin/zsh -c "AttackFrame Operator" -k "$AFS/skel" ghost \
      || useradd -m -s /usr/bin/zsh -c "AttackFrame Operator" -k "$AFS/skel" ghost
    for g in sudo audio video plugdev netdev bluetooth; do getent group "$g" >/dev/null && usermod -aG "$g" ghost; done
  fi
  # passwordless sudo on the live system (live-config's sudo component does the same)
  printf 'ghost ALL=(ALL) NOPASSWD: ALL\n' > /etc/sudoers.d/attackframe-live && chmod 440 /etc/sudoers.d/attackframe-live
  if [[ -f /etc/gdm3/daemon.conf ]] && ! grep -q '^AutomaticLogin=ghost' /etc/gdm3/daemon.conf; then
    sed -i '/^\[daemon\]/a AutomaticLoginEnable=true\nAutomaticLogin=ghost' /etc/gdm3/daemon.conf
  fi
  if id ghost &>/dev/null; then
    for g in docker wireshark kaboxer dialout; do getent group "$g" >/dev/null && usermod -aG "$g" ghost; done
    usermod -s /usr/bin/zsh ghost
    # password from the build (LIVE_PASSWORD, default "ghost") instead of live-config's default
    if [[ -s /etc/attackframe/live-password.hash ]]; then
      usermod -p "$(cat /etc/attackframe/live-password.hash)" ghost && log "ghost password set from the build (LIVE_PASSWORD)"
    else
      log "no /etc/attackframe/live-password.hash — ghost keeps live-config's default password (live)"
    fi
    [[ -f /home/ghost/.zshrc ]] || { cp -rT "$AFS/skel" /home/ghost; chown -R ghost: /home/ghost; }
  fi
else
  mkdir -p /var/lib/attackframe && touch /var/lib/attackframe/firstboot.done
fi
log "complete (live=$LIVE)"
